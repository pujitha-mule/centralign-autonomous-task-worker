# Provider: openai (also used for Groq-compatible endpoints) | mock
# Default is Groq via the OpenAI-compatible SDK.
LLM_PROVIDER=openai

# --- Groq (free, no credit card) ---
OPENAI_API_KEY=gsk_replace_me
OPENAI_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

INTERNAL_API_URL=http://127.0.0.1:8000
MAX_STEPS=15

# Reliability demo: force a 503 on the first submit for this invoice id.
# Leave empty to disable.
FAIL_ONCE_ID=ACME-2024-03
FAIL_RATE=0